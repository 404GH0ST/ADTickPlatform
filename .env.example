API_GATEWAY_ADDR=:8080
GAME_CORE_ADDR=:8081
SUBMISSION_SERVICE_ADDR=:8082
CHECKER_RUNNER_ADDR=:8083
CHECKER_RUNNER_MODE=dry-run
CHECKER_RUNNER_DOCKER_BIN=docker
CHECKER_RUNNER_DOCKER_NETWORK=adplatform_game
CHECKER_RUNNER_TIMEOUT=15s
CONTROLLER_SERVICE_ADDR=:8084
SCORING_WORKER_ADDR=:8085
REALTIME_GATEWAY_ADDR=:8086
REALTIME_SOURCE_URL=http://127.0.0.1:8080
REALTIME_SOURCE_ADMIN_TOKEN=replace-with-a-long-random-admin-token
REALTIME_ADMIN_TOKEN=replace-with-a-long-random-admin-token
REALTIME_POLL_INTERVAL=2s
WIREGUARD_GATEWAY_ADDR=:8087

# memory is dev-only. use postgres for any serious local integration run.
API_GATEWAY_STATE_BACKEND=memory
API_GATEWAY_AUTO_MIGRATE=true
GAME_CORE_STATE_BACKEND=memory
GAME_CORE_AUTO_MIGRATE=true
GAME_CORE_SCHEDULER_ENABLED=false
GAME_CORE_SCHEDULER_INTERVAL=60s
GAME_CORE_MATCH_START_AT=
GAME_CORE_MATCH_END_AT=
GAME_CORE_WARMUP_REQUIRED=true
GAME_CORE_WARMUP_TIMEOUT_SECONDS=60s
GAME_CORE_WARMUP_MIN_SUCCESS_RATE=1.0
GAME_CORE_AUTO_TICK_ON_MATCH_START=true
GAME_CORE_CHECKER_PHASES=put,get,check
GAME_CORE_CHECKER_TIMEOUT_SECONDS=15
GAME_CORE_FLAG_SECRET=replace-with-a-long-random-flag-secret
CONTROLLER_STATE_BACKEND=memory
CONTROLLER_AUTO_MIGRATE=true
CONTROLLER_RUNTIME_MODE=dry-run
AD_PLATFORM_NETWORK_LAYOUT=per-service
CONTROLLER_DOCKER_NETWORK=adplatform_game
AD_PLATFORM_GAME_NETWORK_SUBNET=10.80.0.0/16
CONTROLLER_DOCKER_BIN=docker
CONTROLLER_STATE_MOUNT_PATH=/opt/ad/state
CONTROLLER_RUNTIME_TIMEOUT=15s
CONTROLLER_SSH_PASSWORD_APPLY_MODE=docker-exec
CONTROLLER_SSH_CONTRACT_MODE=verify
CONTROLLER_ACCESS_MODE=dry-run
CONTROLLER_RECONCILE_DEPLOYMENTS_ON_STARTUP=true
CONTROLLER_RECONCILE_ACCESS_ON_STARTUP=true
CONTROLLER_ACCESS_INTERFACE=wg0
CONTROLLER_ACCESS_FIREWALL_BACKEND=nftables
CONTROLLER_ACCESS_NFT_BIN=nft
CONTROLLER_ACCESS_IPTABLES_BIN=iptables-nft
CONTROLLER_ACCESS_FIREWALL_TABLE=adplatform_service_access
CONTROLLER_ACCESS_RULES_PATH=.runtime/controller/access.nft
CONTROLLER_ACCESS_STATUS_PATH=.runtime/controller/access-status.json
CONTROLLER_ACCESS_TIMEOUT=10s
CONTROLLER_INTERNAL_URL=http://127.0.0.1:8084
CONTROLLER_INTERNAL_TOKEN=replace-with-a-long-random-admin-token
GAME_CORE_INTERNAL_URL=http://127.0.0.1:8081
GAME_CORE_INTERNAL_TOKEN=replace-with-a-long-random-admin-token
GAME_CORE_CLIENT_TIMEOUT=3m
SUBMISSION_SERVICE_INTERNAL_URL=http://127.0.0.1:8082
SUBMISSION_SERVICE_INTERNAL_TOKEN=replace-with-a-long-random-admin-token
SCORING_WORKER_INTERNAL_URL=http://127.0.0.1:8085
SCORING_WORKER_INTERNAL_TOKEN=replace-with-a-long-random-admin-token
CHECKER_RUNNER_INTERNAL_URL=http://127.0.0.1:8083
CHECKER_RUNNER_INTERNAL_TOKEN=replace-with-a-long-random-admin-token
WIREGUARD_GATEWAY_STATE_BACKEND=memory
WIREGUARD_GATEWAY_AUTO_MIGRATE=true
WIREGUARD_GATEWAY_MODE=dry-run
WIREGUARD_GATEWAY_RECONCILE_ON_STARTUP=true
WIREGUARD_GATEWAY_CONFIG_PATH=.runtime/wireguard/wg0.conf
WIREGUARD_GATEWAY_PEERS_PATH=.runtime/wireguard/peers.json
WIREGUARD_GATEWAY_RULES_PATH=.runtime/wireguard/nftables.conf
WIREGUARD_GATEWAY_STATUS_PATH=.runtime/wireguard/status.json
WIREGUARD_GATEWAY_INTERNAL_URL=http://127.0.0.1:8087
WIREGUARD_GATEWAY_INTERNAL_TOKEN=replace-with-a-long-random-admin-token
WIREGUARD_GATEWAY_INTERFACE=wg0
WIREGUARD_GATEWAY_WG_BIN=wg
WIREGUARD_GATEWAY_FIREWALL_BACKEND=nftables
WIREGUARD_GATEWAY_NFT_BIN=nft
WIREGUARD_GATEWAY_FIREWALL_TABLE=adplatform_wireguard
WIREGUARD_GATEWAY_APPLY_TIMEOUT=10s
WIREGUARD_SERVER_ENDPOINT=
# Optional. If empty or left at the example value, participant configs derive the
# endpoint from AD_PLATFORM_PUBLIC_BASE_URL and WIREGUARD_SERVER_LISTEN_PORT.
WIREGUARD_SERVER_ADDRESS=10.70.0.1/16
WIREGUARD_SERVER_LISTEN_PORT=51820
WIREGUARD_SERVER_ALLOWED_IPS=10.70.0.0/16,10.80.0.0/16
WIREGUARD_SERVER_DNS=1.1.1.1
WIREGUARD_SERVER_PRIVATE_KEY=
API_GATEWAY_TEAM_ID=101
API_GATEWAY_AUTO_SEED=true
POSTGRES_HOST_PORT=15432
REDIS_HOST_PORT=16379
POSTGRES_DSN=postgres://adplatform:adplatform@127.0.0.1:15432/adplatform?sslmode=disable
REDIS_ADDR=127.0.0.1:16379
REDIS_PASSWORD=
DATABASE_INCLUDE_SEEDS=true
API_GATEWAY_RATE_LIMIT_REDIS_ADDR=
API_GATEWAY_RATE_LIMIT_REDIS_PASSWORD=
# Set true only when API gateway is reachable exclusively through a trusted
# reverse proxy that overwrites X-Forwarded-For.
API_GATEWAY_TRUST_PROXY_HEADERS=false
TEAM_JWT_DEV_TOKEN=dev-team-token
TEAM_JWT_SECRET=replace-with-a-long-random-team-jwt-secret
UNLOCK_PROOF_SECRET=replace-with-a-long-random-unlock-proof-secret
SSH_CREDENTIAL_SECRET=replace-with-a-long-random-stable-ssh-secret
ADMIN_API_TOKEN=replace-with-a-long-random-admin-token

AD_PLATFORM_PUBLIC_BASE_URL=http://127.0.0.1:3000
AD_PLATFORM_API_URL=http://127.0.0.1:8080
AD_PLATFORM_REALTIME_URL=http://127.0.0.1:8086
# Browser clients use same-origin Next.js proxy routes.
# This URL is the server-side realtime upstream for web route handlers.
AD_PLATFORM_CONTROLLER_URL=http://127.0.0.1:8084
# Optional smoke-script credentials. The participant web uses /login.
AD_PLATFORM_EMAIL=alpha.captain@example.com
AD_PLATFORM_PASSWORD=alpha-secret
AD_PLATFORM_TEAM_ID=101
