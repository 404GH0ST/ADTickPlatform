{
  "name": "@ad-platform/web",
  "private": true,
  "type": "module",
  "scripts": {
    "themes": "bun scripts/generate-themes.mjs",
    "dev": "bun run themes && next dev --webpack",
    "build": "bun run themes && next build --webpack",
    "start": "next start",
    "typecheck": "bun run themes && next typegen && tsc --noEmit",
    "e2e": "bun run build && playwright test",
    "e2e:smoke": "bun run build && playwright test e2e/participant-auth.spec.ts e2e/admin-game.spec.ts e2e/realtime-updates.spec.ts",
    "test": "bun run themes && bun test ./lib",
    "ui:add": "bunx --bun shadcn@latest add",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.82.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "oxlint": "^1.95.0",
    "postcss": "8.5.33",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2"
  }
}
