{$EDGE_SITE_ADDRESS:https://localhost} {
	{$EDGE_TLS_DIRECTIVE}

	encode zstd gzip
	header {
		Content-Security-Policy "frame-ancestors 'none'"
		X-Frame-Options "DENY"
		-Server
		-X-Powered-By
	}

	@api path /api/v2/* /healthz
	handle @api {
		reverse_proxy api-gateway:8080
	}

	@realtime path /public/v1/*
	handle @realtime {
		reverse_proxy realtime-gateway:8086
	}

	handle {
		reverse_proxy web:3000
	}
}
