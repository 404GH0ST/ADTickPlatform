# Copy to deploy/compose/prod.env (or run: make generate-prod-env).
# Prefer: make generate-prod-env [CHALLENGE_SOURCE_HOST_PATH=...] [ADMIN_EMAIL=...]

# --- Edge (public site) -----------------------------------------------------
# Use the same host in the browser and smoke tests (prefer localhost over 127.0.0.1).
EDGE_SITE_ADDRESS=http://localhost
EDGE_HTTP_PUBLIC_PORT=80
EDGE_HTTPS_PUBLIC_PORT=443
# setup-prod-env fills this when SCHEME=https (self-signed Caddy cert).
EDGE_TLS_DIRECTIVE=
AD_PLATFORM_PUBLIC_BASE_URL=http://localhost

# --- Organizer bootstrap (make create-admin) --------------------------------
# generate-prod-env fills ADMIN_PASSWORD with a random value.
ADMIN_DISPLAY_NAME=Organizer
ADMIN_EMAIL=organizer@example.com
ADMIN_PASSWORD=change-this-admin-password

# --- Optional participant smoke credentials ---------------------------------
# Only needed for make smoke-prod-host-* against a real player account.
AD_PLATFORM_EMAIL=
AD_PLATFORM_PASSWORD=
AD_PLATFORM_TEAM_ID=

# --- Postgres / Redis -------------------------------------------------------
POSTGRES_DB=adplatform
POSTGRES_USER=adplatform
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_DSN=postgres://adplatform:change-this-postgres-password@postgres:5432/adplatform?sslmode=disable
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
API_GATEWAY_RATE_LIMIT_REDIS_ADDR=redis:6379
API_GATEWAY_RATE_LIMIT_REDIS_PASSWORD=
# true only if the edge proxy always overwrites X-Forwarded-For.
API_GATEWAY_TRUST_PROXY_HEADERS=false

# --- Service tokens / secrets -----------------------------------------------
ADMIN_API_TOKEN=change-this-admin-token
CONTROLLER_INTERNAL_TOKEN=change-this-controller-internal-token
GAME_CORE_INTERNAL_TOKEN=change-this-game-core-internal-token
SUBMISSION_SERVICE_INTERNAL_TOKEN=change-this-submission-service-internal-token
SCORING_WORKER_INTERNAL_TOKEN=change-this-scoring-worker-internal-token
CHECKER_RUNNER_INTERNAL_TOKEN=change-this-checker-runner-internal-token
WIREGUARD_GATEWAY_INTERNAL_TOKEN=change-this-wireguard-gateway-internal-token
REALTIME_ADMIN_TOKEN=change-this-realtime-admin-token
TEAM_JWT_SECRET=change-this-team-jwt-secret
UNLOCK_PROOF_SECRET=change-this-unlock-proof-secret
SSH_CREDENTIAL_SECRET=change-this-stable-ssh-credential-secret
GAME_CORE_FLAG_SECRET=change-this-flag-secret
API_GATEWAY_AUTO_SEED=false
DATABASE_INCLUDE_SEEDS=false

# --- Match / checker --------------------------------------------------------
GAME_CORE_SCHEDULER_ENABLED=false
GAME_CORE_SCHEDULER_INTERVAL=300s
GAME_CORE_MATCH_START_AT=
GAME_CORE_MATCH_END_AT=
GAME_CORE_WARMUP_REQUIRED=true
GAME_CORE_WARMUP_TIMEOUT_SECONDS=60s
GAME_CORE_WARMUP_MIN_SUCCESS_RATE=1.0
GAME_CORE_WARMUP_PUT_RETRIES=2
GAME_CORE_WARMUP_PUT_RETRY_DELAY=2s
GAME_CORE_AUTO_TICK_ON_MATCH_START=true
GAME_CORE_CHECKER_PHASES=put,get,check
GAME_CORE_CHECKER_TIMEOUT_SECONDS=15
# Peak checker vCPU ≈ PARALLELISM * CHECKER_RUNNER_CPUS (leave host headroom).
GAME_CORE_CHECKER_PARALLELISM=16
GAME_CORE_TICK_TIMEOUT=180s
GAME_CORE_SCORING_DEBOUNCE=1s
GAME_CORE_SCORING_RETRY_DELAY=5s

# --- Game network / challenge containers ------------------------------------
AD_PLATFORM_NETWORK_LAYOUT=per-service
AD_PLATFORM_GAME_NETWORK_SUBNET=10.80.0.0/16
CONTROLLER_DOCKER_NETWORK=adplatform_prod_game
CHECKER_RUNNER_DOCKER_NETWORK=adplatform_prod_game
CHECKER_RUNNER_CAP_DROP=ALL
CHECKER_RUNNER_CAP_ADD=
CHECKER_RUNNER_SECURITY_OPT=no-new-privileges:true
CHECKER_RUNNER_PIDS_LIMIT=128
CHECKER_RUNNER_MEMORY=256m
CHECKER_RUNNER_CPUS=0.5
CONTROLLER_SERVICE_CAP_DROP=ALL
CONTROLLER_SERVICE_CAP_ADD=CHOWN,DAC_OVERRIDE,FOWNER,SETGID,SETUID,NET_BIND_SERVICE,SYS_CHROOT,AUDIT_WRITE
CONTROLLER_SERVICE_SECURITY_OPT=
CONTROLLER_SERVICE_PIDS_LIMIT=256
CONTROLLER_SERVICE_MEMORY=512m
CONTROLLER_SERVICE_CPUS=1.0

# Host directory mounted into api-gateway as AD_CHALLENGE_SOURCE_ROOT (read-only).
# Override at generate time: make generate-prod-env CHALLENGE_SOURCE_HOST_PATH=/path
CHALLENGE_SOURCE_HOST_PATH=/srv/adplatform/challenge-sources
AD_CHALLENGE_SOURCE_ROOT=/challenge-sources

# --- Host-enforcement (make up-prod-host) ------------------------------------
POSTGRES_LOOPBACK_PORT=15432
CHECKER_RUNNER_LOOPBACK_PORT=18083
POSTGRES_DSN_HOST_ENFORCEMENT=postgres://adplatform:change-this-postgres-password@127.0.0.1:15432/adplatform?sslmode=disable
CONTROLLER_SERVICE_ADDR_HOST=:18084
WIREGUARD_GATEWAY_ADDR_HOST=:18087
CONTROLLER_INTERNAL_URL_HOST=http://host.docker.internal:18084
WIREGUARD_GATEWAY_INTERNAL_URL_HOST=http://host.docker.internal:18087
CHECKER_RUNNER_INTERNAL_URL_HOST=http://127.0.0.1:18083
CONTROLLER_ACCESS_MODE=host
CONTROLLER_RECONCILE_DEPLOYMENTS_ON_STARTUP=true
CONTROLLER_RECONCILE_ACCESS_ON_STARTUP=true
CONTROLLER_ACCESS_INTERFACE=wg0
CONTROLLER_ACCESS_FIREWALL_BACKEND=iptables
CONTROLLER_ACCESS_NFT_BIN=nft
CONTROLLER_ACCESS_IPTABLES_BIN=iptables
CONTROLLER_ACCESS_FIREWALL_TABLE=adplatform_service_access
CONTROLLER_ACCESS_TIMEOUT=10s
WIREGUARD_GATEWAY_MODE=host
WIREGUARD_GATEWAY_RECONCILE_ON_STARTUP=true
WIREGUARD_GATEWAY_INTERFACE=wg0
WIREGUARD_GATEWAY_WG_BIN=wg
WIREGUARD_GATEWAY_FIREWALL_BACKEND=nftables
WIREGUARD_GATEWAY_NFT_BIN=nft
WIREGUARD_GATEWAY_FIREWALL_TABLE=adplatform_wireguard
WIREGUARD_GATEWAY_APPLY_TIMEOUT=10s

# --- WireGuard VPN ----------------------------------------------------------
# setup-prod-env sets WIREGUARD_SERVER_ENDPOINT from DOMAIN + WG_PORT.
WIREGUARD_SERVER_ENDPOINT=
WIREGUARD_SERVER_ADDRESS=10.70.0.1/16
WIREGUARD_SERVER_LISTEN_PORT=51820
WIREGUARD_SERVER_ALLOWED_IPS=10.70.0.0/16,10.80.0.0/16
WIREGUARD_SERVER_DNS=1.1.1.1
WIREGUARD_SERVER_PRIVATE_KEY=replace-with-a-real-private-key

# --- Monitoring (host ports; not on the participant edge) -------------------
PROMETHEUS_HOST_PORT=19090
GRAFANA_HOST_PORT=13000
PROMETHEUS_RETENTION=30d
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-grafana-admin-password
